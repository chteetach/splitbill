# PostgreSQL connection string used by the API and Alembic (SQLAlchemy URL, psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://splitbill:change-me@localhost:5432/splitbill

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Database used by the test suite. WARNING: the tests drop and recreate every table in it.
TEST_DATABASE_URL=postgresql+psycopg://splitbill:change-me@localhost:5432/splitbill_test
